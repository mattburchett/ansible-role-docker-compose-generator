{{ ansible_managed | comment }}
---
services:
{% for container in containers %}
{% if container.active %}
{% set _meta = ['active', 'service_name', 'include_global_env_vars'] %}
{% set ns = namespace(svc={}) %}
{% for key in container if key not in _meta %}
{% set ns.svc = ns.svc | combine({key: container[key]}) %}
{% endfor %}
{% if container.include_global_env_vars | default(false) and global_env_vars is defined %}
{% set ns.svc = ns.svc | combine({'environment': global_env_vars + (ns.svc.environment | default([]))}) %}
{% endif %}
  {{ container.service_name }}:
{{ ns.svc | to_docker_compose_yaml(indent=2) | indent(4, true) }}
{% endif %}
{% endfor %}

{% if compose_networks is defined %}
networks:
{% for network in compose_networks %}
  {{ network.name }}:
{% set ns_net = namespace(net={}) %}
{% for key in network if key not in ['name', 'network_name'] %}
{% set ns_net.net = ns_net.net | combine({key: network[key]}) %}
{% endfor %}
{% if network.network_name is defined %}
{% set ns_net.net = ns_net.net | combine({'name': network.network_name}) %}
{% endif %}
{{ ns_net.net | to_docker_compose_yaml(indent=2) | indent(4, true) }}
{% endfor %}
{% endif %}

{% if volumes is defined %}
volumes:
{% for volume in volumes %}
  {{ volume }}:
{% endfor %}
{% endif %}
